using System.Diagnostics;
using System;

namespace Sample.Beef.Chip8;

public struct Chip8Memory
{
    public struct ADDRESS
    {
        // | 0x200 ~ 0xFFF | Program  |
        // | 0x081 ~ 0x199 | Unused   |
        // | 0x000 ~ 0x080 | Font Set |
        public const int ADDR_PROGRAM_LOAD = 0x200;
    }

    const u8[?] CHIP8_DEFAULT_CHARACTER_SET = .(
        0xf0, 0x90, 0x90, 0x90, 0xf0, // 0 0x00
        0x20, 0x60, 0x20, 0x20, 0x70, // 1 0x05
        0xf0, 0x10, 0xf0, 0x80, 0xf0, // 2 0x0A
        0xf0, 0x10, 0xf0, 0x10, 0xf0, // 3 0x0F
        0x90, 0x90, 0xf0, 0x10, 0x10, // 4 0x14
        0xf0, 0x80, 0xf0, 0x10, 0xf0, // 5 0x19
        0xf0, 0x80, 0xf0, 0x90, 0xf0, // 6 0x1E
        0xf0, 0x10, 0x20, 0x40, 0x40, // 7 0x23
        0xf0, 0x90, 0xf0, 0x90, 0xf0, // 8 0x28
        0xf0, 0x90, 0xf0, 0x10, 0xf0, // 9 0x2D
        0xf0, 0x90, 0xf0, 0x90, 0x90, // A 0x32
        0xe0, 0x90, 0xe0, 0x90, 0xe0, // B 0x37
        0xf0, 0x80, 0x80, 0x80, 0xf0, // C 0x3C
        0xe0, 0x90, 0x90, 0x90, 0xe0, // D 0x41
        0xf0, 0x80, 0xf0, 0x80, 0xf0, // E 0x46
        0xf0, 0x80, 0xf0, 0x80, 0x80 /// F 0x4B
        );

    u8[4096] _ram = .(); // 4KB == 0x1000

    public void Init() mut
    {
        Span<u8> charset = CHIP8_DEFAULT_CHARACTER_SET;
        Internal.MemCpy(&_ram, charset.Ptr, CHIP8_DEFAULT_CHARACTER_SET.Count);
    }

    [Inline]
    public void SetU8(int addr, u8 val) mut
    {
        _ram[addr] = val;
    }

    [Inline]
    public u8 PeekU8(int addr)
    {
        u8 data8 = _ram[addr];
        return data8;
    }

    public void WriteFromRomData(Span<uint8> romData)
    {
        Span<u8> span = _ram;
        romData.CopyTo(span[ADDRESS.ADDR_PROGRAM_LOAD...]);
    }

    public Span<u8> GetSpriteData(u16 from, u16 count)
    {
        Span<u8> span = _ram;
        return span[from ..< from + count];
    }
}
